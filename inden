                <div class="flex items-center gap-3.5 bg-[#1a1a1e] border border-zinc-800/80 rounded-2xl p-3">
                    <div class="w-9 h-9 rounded-xl bg-zinc-800 border border-zinc-700/70 flex items-center justify-center shrink-0 text-white animate-rule-icon-5">
                        <i class="fa-solid fa-user-group text-sm"></i>
                    </div>
                    <p class="text-[11.5px] leading-relaxed text-zinc-200 font-medium">
                        គណនីមួយប្រើបានសម្រាប់ឧបករណ៍ផ្ទាល់ខ្លួនប៉ុណ្ណោះ សូមកុំចែករំលែកទៅអ្នកដទៃ ដើម្បីរក្សាល្បឿន និងស្ថិរភាព
                    </p>
                </div>
            </div>

            <button onclick="acceptNotice()" class="w-full py-3.5 rounded-2xl bg-white hover:bg-zinc-200 active:scale-[0.98] text-black font-bold text-sm tracking-wide transition-all shadow-lg cursor-pointer">
