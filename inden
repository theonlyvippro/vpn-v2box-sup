                        <i class="fa-solid fa-lock text-sm"></i>
                    </div>
                    <p class="text-[11.5px] leading-relaxed text-zinc-200 font-medium">
                        សូមរក្សាការសម្ងាត់ និងគោរពតាមគោលការណ៍ប្រើប្រាស់របស់ប្រព័ន្ធ
                    </p>
                </div>

                <div class="flex items-center gap-3.5 bg-[#1a1a1e] border border-zinc-800/80 rounded-2xl p-3">
                    <div class="w-9 h-9 rounded-xl bg-zinc-800 border border-zinc-700/70 flex items-center justify-center shrink-0 text-white animate-rule-icon-3">
