    ====================================================================== -->
    <div class="w-full max-w-md min-h-screen bg-zinc-50 dark:bg-[#09090b] border-x border-zinc-200 dark:border-zinc-800/70 flex flex-col justify-between relative shadow-2xl">

        <!-- Main Scrollable Content Area -->
        <main class="flex-1 px-3.5 pt-3.5 pb-28 overflow-y-auto space-y-3">

            <!-- =============================================================
                 TAB 1: HOME (ផ្ទះ)
            ============================================================== -->
            <section id="tab-home" class="space-y-3">
                <!-- 1. Top Brand Header Card -->
                <div class="rounded-[24px] bg-white dark:bg-[#131316] border border-zinc-200 dark:border-zinc-800/80 p-3.5 flex items-center justify-between shadow-sm">
                    <div class="flex items-center gap-3">
