            const mb = bytes / (1024 * 1024);
            if (mb >= 1024) {
                return `${(mb / 1024).toFixed(2)} GB`;
            }
            return `${mb.toFixed(2)} MB`;
        }

        function startSpeedTest() {
            if (testingSpeed) return;
            testingSpeed = true;

            const icon = document.getElementById('speed-btn-icon');
            const liveText = document.getElementById('live-speed-text');
            const peakText = document.getElementById('peak-speed-text');
            const arc = document.getElementById('speed-arc');

            icon.className = 'fa-solid fa-spinner fa-spin text-xl';
            document.getElementById('speed-status-left').innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-ping"></span> កំពុងវាស់...`;
            document.getElementById('speed-status-right').innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-ping"></span> កំពុងវាស់...`;

            let step = 0;
            const totalSteps = 22;
            const targetSpeed = 415.0 + Math.random() * 65.0; // Smooth fixed target speed
            const ping = serverNodes[selectedServerIndex].ping;
            document.getElementById('res-ping').textContent = ping;

            addSystemLog(`Started smooth speed test on ${serverNodes[selectedServerIndex].name}...`);

            const interval = setInterval(() => {
                step++;
                // Smooth ease-out curve so numbers rise steadily without jumping up and down
                const t = Math.min(step / totalSteps, 1);
                const easeOut = 1 - Math.pow(1 - t, 3);
                const num = targetSpeed * easeOut;
                const currentMbps = num.toFixed(1);

                // Accumulate steady MB & GB proportional to the live speedometer
                const stepBytes = Math.floor(num * 24000);
                totalSessionDownBytes += stepBytes;
                totalSessionUpBytes += stepBytes;

                document.getElementById('tunnel-session-bytes').textContent =
                    `↓ ${formatSmartBytes(totalSessionDownBytes)} • ↑ ${formatSmartBytes(totalSessionUpBytes)}`;

                // Sync Tracker Total Data
                const downMB = (totalSessionDownBytes / (1024 * 1024)).toFixed(2);
                const upMB = (totalSessionUpBytes / (1024 * 1024)).toFixed(2);
                const totMB = (parseFloat(downMB) + parseFloat(upMB)).toFixed(2);
                const trackerTotEl = document.getElementById('tracker-total-data');
                if (trackerTotEl) trackerTotEl.textContent = `${totMB} MB`;

                // Update Live Speed, Peak Speed, Download & Upload numbers smoothly
                liveText.textContent = currentMbps;
                peakText.textContent = currentMbps;
                document.getElementById('res-down').textContent = currentMbps;
                document.getElementById('res-up').textContent = (num * 0.42).toFixed(1);

                // Update Progress Bars
                const ratio = Math.min(num / 1000, 1);
                document.getElementById('bar-down').style.width = `${Math.max(15, ratio * 100)}%`;
                document.getElementById('bar-up').style.width = `${Math.max(12, ratio * 65)}%`;
                document.getElementById('bar-ping').style.width = `${Math.max(25, 100 - ping)}%`;

                // Rotate Needle (-112deg at 0 Mbps -> +112deg at 1000 Mbps) & Fill Gauge Arc
                const deg = -112 + (ratio * 224);
                const needle = document.getElementById('speed-needle');
                if (needle) needle.style.transform = `rotate(${deg}deg)`;
                arc.style.strokeDashoffset = 332 - (ratio * 332);

                if (step >= totalSteps) {
                    clearInterval(interval);
                    testingSpeed = false;
                    icon.className = 'fa-solid fa-rotate-right text-xl';
                    document.getElementById('speed-status-left').innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> រួចរាល់`;
                    document.getElementById('speed-status-right').innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> រួចរាល់`;
                    addSystemLog(`Speed test finished: ↓ ${currentMbps} Mbps | ↑ ${(num * 0.42).toFixed(1)} Mbps | Ping ${ping} ms`);
                    showToast(`វាស់ល្បឿនរួចរាល់៖ ${currentMbps} Mbps`);
                }
            }, 100);
        }

        // 10. System Logs, Visitor Tracker, Theme & Language Pill
        let visitorVisits = 11;
        let visitorImports = 3;

        function recordVisitorEvent(type, details) {
            const list = document.getElementById('visitor-tracker-list');
            if (!list) return;
            if (type === 'Import V2Box') {
                visitorImports++;
                const impEl = document.getElementById('tracker-import-count');
                if (impEl) impEl.textContent = visitorImports;
            } else {
                visitorVisits++;
                const visEl = document.getElementById('tracker-visit-count');
                if (visEl) visEl.textContent = visitorVisits;
            }
            const now = new Date();
            const dateStr = `${String(now.getDate()).padStart(2, '0')}/${String(now.getMonth() + 1).padStart(2, '0')}/${now.getFullYear()} ${now.toTimeString().split(' ')[0]}`;
            const badgeStyle = type === 'Import V2Box'
                ? 'bg-emerald-500/15 border-emerald-500/30 text-emerald-400'
                : 'bg-indigo-500/15 border-indigo-500/30 text-indigo-400';

            const item = document.createElement('div');
            item.className = 'rounded-2xl bg-zinc-50 dark:bg-[#0d0d10] border border-zinc-200 dark:border-zinc-800/80 p-3 flex items-center justify-between gap-2';
            item.innerHTML = `
                <div class="min-w-0">
                    <p class="text-xs font-extrabold font-mono text-zinc-900 dark:text-white truncate">ID: 5b18efac-c0e7-4013-8f7f...</p>
                    <p class="text-[10px] text-zinc-500 font-mono truncate mt-1">${details}</p>
                </div>
                <div class="text-right shrink-0">
                    <span class="inline-block px-2.5 py-0.5 rounded-full border text-[10px] font-bold ${badgeStyle}">${type}</span>
                    <p class="text-[9.5px] text-zinc-500 font-mono mt-1">${dateStr}</p>
                </div>
            `;
            list.prepend(item);
        }

        function copyTrackerLogs() {
            const summary = `TheOnlyVIP Tracker — Visits: ${visitorVisits}, Imports: ${visitorImports}, Total Data: ${document.getElementById('tracker-total-data')?.textContent || '0.30 MB'}`;
            copyText(summary, 'បានចម្លងកំណត់ត្រាអ្នកចូលប្រើប្រាស់!');
        }

        function clearVisitorTracker() {
            const list = document.getElementById('visitor-tracker-list');
            if (list) list.innerHTML = '';
            visitorVisits = 0;
            visitorImports = 0;
            document.getElementById('tracker-visit-count').textContent = '0';
            document.getElementById('tracker-import-count').textContent = '0';
            showToast('បានលុបកំណត់ត្រាសមាជិករួចរាល់');
        }

        function addSystemLog(message) {
            const box = document.getElementById('system-logs-box');
            if (!box) return;
            const now = new Date();
            const timeStr = now.toTimeString().split(' ')[0];
            const line = document.createElement('div');
            line.className = 'leading-relaxed';
            line.innerHTML = `<span class="text-emerald-500">[${timeStr}]</span> <span class="text-emerald-400">${message}</span>`;
            box.prepend(line);
        }

        function clearSystemLogs() {
            const box = document.getElementById('system-logs-box');
            box.innerHTML = `<div class="leading-relaxed text-emerald-400">[SYSTEM] Portal ready.</div>`;
        }

        function toggleTheme() {
            const html = document.documentElement;
            html.classList.toggle('dark');
            const isDark = html.classList.contains('dark');
            const sunIcon = document.getElementById('theme-sun-icon');
            const shortLabel = document.getElementById('theme-short-label');
            if (sunIcon && shortLabel) {
                sunIcon.className = isDark ? 'fa-solid fa-sun text-amber-400 text-xs' : 'fa-solid fa-moon text-indigo-500 text-xs';
                shortLabel.textContent = isDark ? 'ស' : 'ងងឹត';
            }
            showToast(isDark ? 'បានបើកផ្ទៃងងឹត (Dark Mode)' : 'បានបើកផ្ទៃភ្លឺ (Light Mode)');
        }

        function toggleLangHint() {
            currentLang = currentLang === 'km' ? 'en' : 'km';
            const pill = document.getElementById('btn-lang-pill');
            pill.textContent = currentLang === 'km' ? 'EN' : 'KM';

            const dict = translations[currentLang];
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (dict[key]) {
                    el.innerHTML = dict[key];
                }
            });

            document.getElementById('nav-label-home').textContent = dict.navHome;
            document.getElementById('nav-label-servers').textContent = dict.navServers;
            document.getElementById('nav-label-speed').textContent = dict.navSpeed;
            document.getElementById('nav-label-tracker').textContent = dict.navTracker;
            document.getElementById('nav-label-settings').textContent = dict.navSettings;

            const active = serverNodes[selectedServerIndex];
            document.getElementById('home-region-text').textContent =
                currentLang === 'km' ? `តំបន់៖ ${active.regionDisplay}` : `Region: ${active.regionDisplay}`;

            updateLiveDateTime();
            showToast(currentLang === 'km' ? 'បានប្តូរទៅភាសាខ្មែរ (Khmer)' : 'Switched to English');
        }

        // 11. Toast Notification Helper
        let toastTimeout;
        function showToast(msg) {
            const box = document.getElementById('toast-box');
            const label = document.getElementById('toast-message');
            label.textContent = msg;
            box.classList.remove('opacity-0', '-translate-y-2');
            box.classList.add('opacity-100', 'translate-y-0');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                box.classList.add('opacity-0', '-translate-y-2');
                box.classList.remove('opacity-100', 'translate-y-0');
            }, 2200);
        }

        // 12. Detect Client Device OS
        function detectClientEnvironment() {
            const ua = navigator.userAgent || '';
            let os = 'Desktop';
            if (/Android/i.test(ua)) os = 'Android';
            else if (/iPhone|iPad|iPod/i.test(ua)) os = 'iOS';
            else if (/Windows/i.test(ua)) os = 'Windows';
            else if (/Mac/i.test(ua)) os = 'macOS';

            document.getElementById('client-os-label').textContent = `ប្រព័ន្ធ៖ ${os}`;
        }

        // Initialize on Window Load
        window.addEventListener('DOMContentLoaded', () => {
            detectClientEnvironment();
            updateLiveDateTime();
            setInterval(updateLiveDateTime, 1000);
            renderServers();
            const box = document.getElementById('system-logs-box');
            if (box) {
                box.innerHTML = `<div class="leading-relaxed text-emerald-400">[SYSTEM] Portal ready.</div>`;
            }
            addSystemLog('Selected server region: 🇸🇬 Singapore (SG)');
            addSystemLog('TheOnlyVIP Portal initialized.');
            addSystemLog('Connected IP detected: 103.68.45.212 (KH • Cambodia)');
        });
    </script>
