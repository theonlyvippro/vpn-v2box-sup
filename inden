<!DOCTYPE html>
<html lang="km" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>TheOnlyVIP — ប្រព័ន្ធគ្រប់គ្រង V2Box VIP</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Kantumruy Pro & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Kantumruy+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- QRCode.js Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Kantumruy Pro', 'Inter', 'sans-serif'],
                        mono: ['ui-monospace', 'SFMono-Regular', 'Menlo', 'Monaco', 'Consolas', 'monospace']
                    }
                }
            }
        }
    </script>

    <style>
        * {
            -webkit-tap-highlight-color: transparent;
            box-sizing: border-box;
        }
        body {
            font-family: 'Kantumruy Pro', 'Inter', sans-serif;
            overflow-x: hidden;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(156, 163, 175, 0.3);
            border-radius: 9999px;
        }

        /* Slow Floating & Gentle Pulse Animations for Notice Modal */
        @keyframes slowFloat {
            0%, 100% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-5px) scale(1.03); }
        }
        @keyframes gentleIconSway {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-2.5px) rotate(3deg); }
        }
        @keyframes softRingPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.16); }
            50% { box-shadow: 0 0 0 10px rgba(255, 255, 255, 0); }
        }
        @keyframes hotBurnGlow {
            0%, 100% {
                box-shadow: 0 0 14px rgba(249, 115, 22, 0.35), inset 0 0 10px rgba(249, 115, 22, 0.12);
            }
            50% {
                box-shadow: 0 0 26px rgba(249, 115, 22, 0.7), inset 0 0 16px rgba(249, 115, 22, 0.24);
            }
        }
        @keyframes badgeFloatMove {
            0%, 100% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-2px) scale(1.06); }
        }
        @keyframes cornerRibbonPulse {
            0%, 100% { filter: brightness(1); }
            50% { filter: brightness(1.18); }
        }

        .animate-shield-float {
            animation: slowFloat 4s ease-in-out infinite, softRingPulse 3.5s ease-in-out infinite;
        }
        .animate-rule-icon-1 { animation: gentleIconSway 3.6s ease-in-out 0.0s infinite; }
        .animate-rule-icon-2 { animation: gentleIconSway 3.6s ease-in-out 0.3s infinite; }
        .animate-rule-icon-3 { animation: gentleIconSway 3.6s ease-in-out 0.6s infinite; }
        .animate-rule-icon-4 { animation: gentleIconSway 3.6s ease-in-out 0.9s infinite; }
        .animate-rule-icon-5 { animation: gentleIconSway 3.6s ease-in-out 1.2s infinite; }
        .animate-hot-burn { animation: hotBurnGlow 1.8s ease-in-out infinite; }
        .animate-badge-move { animation: badgeFloatMove 1.4s ease-in-out infinite; }
        .animate-corner-ribbon { animation: cornerRibbonPulse 2s ease-in-out infinite; }

        /* Speedometer Needle Transition */
        #speed-needle {
            transform-origin: 110px 110px;
            transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
        }
        #speed-arc {
            transition: stroke-dashoffset 0.25s cubic-bezier(0.22, 1, 0.36, 1);
        }
    </style>
</head>
<body class="bg-zinc-100 dark:bg-[#08080a] text-zinc-900 dark:text-zinc-100 min-h-screen flex justify-center selection:bg-amber-500 selection:text-black">

    <!-- =====================================================================
         INITIAL NOTICE MODAL (MONOCHROME BLACK & WHITE)
    ====================================================================== -->
    <div id="welcome-notice-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md flex items-end sm:items-center justify-center p-2 sm:p-4 transition-opacity duration-300">
        <div class="w-full max-w-md bg-[#121214] border border-zinc-800/90 rounded-[28px] p-5 sm:p-6 shadow-2xl text-white flex flex-col max-h-[94vh] overflow-y-auto">
            <div class="w-10 h-1 bg-zinc-700 rounded-full mx-auto mb-4"></div>

            <div class="flex flex-col items-center text-center mb-5">
                <div class="w-16 h-16 rounded-full bg-zinc-800/80 border border-zinc-700 flex items-center justify-center mb-3 animate-shield-float">
                    <div class="w-11 h-11 rounded-full bg-white text-black flex items-center justify-center shadow-lg">
                        <i class="fa-solid fa-shield-halved text-xl"></i>
                    </div>
                </div>
                <p class="text-[11px] font-medium text-zinc-400 tracking-wide mb-1">ការជូនដំណឹងសំខាន់</p>
                <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight mb-2.5">សូមអានការណែនាំមុនប្រើប្រាស់</h2>
